# Copy to .env and fill in. Never commit .env.
FLASK_APP=app.py
FLASK_ENV=development
# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

POSTGRES_USER=akayza
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=akayza_dev
POSTGRES_TEST_DB=akayza_test

# Token lifetimes: short access token, rotating refresh token.
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Email. "fake" prints emails (and sign-up codes) to the backend log;
# development only. "smtp" sends for real through any SMTP relay.
# Delivery behaviour (timeout, retries, background sending) is in code:
# src/config.py. Only WHERE and AS WHOM we send belongs here.
MAIL_PROVIDER=fake

# Mail server (example: a Gmail account with an app password)
#   MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USE_TLS=true
#   MAIL_USERNAME=you@gmail.com  MAIL_PASSWORD=<16-char app password>
#   MAIL_DEFAULT_SENDER=Akayza Dev <you@gmail.com>
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Akayza <no-reply@akayza.co.za>
MAIL_REPLY_TO=

# Mapbox token for address search (server-side only; starts with pk.).
MAPBOX_TOKEN=

# Continue with Google: OAuth client IDs (Android + web), comma-separated.
# Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=
