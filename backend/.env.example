# Copy to .env and fill in. Never commit .env.
FLASK_APP=app.py
FLASK_ENV=development
# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

POSTGRES_USER=akayza
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=akayza_dev
POSTGRES_TEST_DB=akayza_test

# Token lifetimes: short access token, rotating refresh token.
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Email. "fake" prints emails (and sign-up codes) to the backend log;
# development only. For real email set MAIL_PROVIDER=smtp and the rest
# (any SMTP relay: Brevo, SendGrid, Amazon SES, Mailgun...).
MAIL_PROVIDER=fake
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Akayza <no-reply@akayza.co.za>
MAIL_REPLY_TO=

# Mapbox token for address search (server-side only; starts with pk.).
MAPBOX_TOKEN=
