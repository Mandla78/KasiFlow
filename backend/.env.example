# Copy to .env and fill in. Never commit .env.
FLASK_APP=app.py
FLASK_ENV=development
# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

POSTGRES_USER=akayza
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=akayza_dev
POSTGRES_TEST_DB=akayza_test

# Token lifetimes: short access token, rotating refresh token.
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Email. "smtp" sends for real through any SMTP relay (the default).
# "fake" is for the automated tests only: it sends nothing, and codes are
# never written to any log. Delivery behaviour (timeout, retries,
# background sending) is in code: src/config.py. Only WHERE and AS WHOM we
# send belongs here.
MAIL_PROVIDER=smtp

# Mail server (example: a Gmail account with an app password)
#   MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USE_TLS=true
#   MAIL_USERNAME=you@gmail.com  MAIL_PASSWORD=<16-char app password>
#   MAIL_DEFAULT_SENDER=Akayza <you@gmail.com>   (Gmail only sends as the signed-in address)
#   MAIL_REPLY_TO=you@gmail.com                  (an inbox someone reads; never a no-reply)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Akayza <no-reply@akayza.co.za>
MAIL_REPLY_TO=

# Mapbox token for address search (server-side only; starts with pk.).
MAPBOX_TOKEN=

# Continue with Google: OAuth client IDs (Android + web), comma-separated.
# Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=

# Public address of this backend, for every link a person taps: the password
# reset email and the job sign-off link sent on WhatsApp. It must be https
# and a real name, not an IP:
#   - WhatsApp only makes "10.0.0.5" clickable, dropping the port and ticket
#   - phones upgrade the link to https, which the local http server can't answer
# Development: an https tunnel to port 5000, e.g. your free static ngrok domain
#   ngrok http 5000 --url=https://<your-domain>.ngrok-free.dev
# (the same address as CLOUDINARY_WEBHOOK_BASE_URL). Restart the backend after
# changing it. Production: the backend's https address (required).
APP_BASE_URL=http://localhost:5000

# Media: Cloudinary (Settings -> API Keys). The secret stays on the server;
# the phone only ever gets a one-upload signature.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top folder on Cloudinary: keep development uploads apart from real ones.
MEDIA_ROOT_FOLDER=akayza-dev
# Optional: public https URL of this backend (e.g. an ngrok tunnel) so
# Cloudinary can call /api/v1/media/webhooks/cloudinary-notifications.
CLOUDINARY_WEBHOOK_BASE_URL=
# Malware scan on upload (needs the Perception Point add-on). Off by default.
CLOUDINARY_MODERATION_ENABLED=false

# PayFast (sandbox.payfast.co.za -> Account Information). Set a passphrase
# there first; it signs every payment. Never commit or share these.
# PAYFAST_TRUST_PROXY=true when PayFast reaches us through ngrok.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_TRUST_PROXY=false

# The client's IP (shared/net/client_ip.py). true ONLY when the backend is
# reached through Cloudflare alone (a cloudflared tunnel): then rate limits,
# sessions and the audit trail use Cloudflare's CF-Connecting-IP.
BEHIND_CLOUDFLARE=false
