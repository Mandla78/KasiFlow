# Copy to .env (git-ignored) and fill in:   copy .env.example .env
# Only PUBLIC values go here: anything EXPO_PUBLIC_* is built into the app,
# and anyone who installs it can read it. Secrets belong in backend/.env.
# Restart `npx expo start` after changing this file.

# Mapbox PUBLIC token (starts with pk.). Empty = development map (OpenStreetMap).
EXPO_PUBLIC_MAPBOX_TOKEN=

# Where the app finds the backend. "localhost" is the PHONE itself, not your PC,
# so for a phone use your PC's address, e.g. http://192.168.1.20:5000/api/v1
# (ipconfig -> IPv4 Address), or a tunnel URL when not on the same Wi-Fi.
# Unused until the mock APIs are switched to the real backend.
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Sign-in against the real backend (false) or the built-in mock (true).
# Only identity is wired so far; onboarding and suppliers stay mocked.
EXPO_PUBLIC_USE_MOCK_API=true
